# Local default; omit DATABASE_URL for the same SQLite default.
DATABASE_URL="file:./dev.db"
# Production: use the pooled Neon Postgres connection string instead.
# DATABASE_URL="postgresql://..."
SOCIALGLASS_MODE="mock"
# Optional: omitted keys use clearly labeled, curated demo outputs.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
OPENAI_API_KEY=""
IMAGE_MODEL="gpt-image-1"
BLOB_READ_WRITE_TOKEN=""
# Required on Vercel: the app fails closed when this is absent.
APP_PASSWORD=""
